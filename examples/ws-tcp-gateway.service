[Unit]
Description=WebSocket to TCP gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ws-gateway
Group=ws-gateway
ExecStart=/usr/local/bin/ws-tcp-gateway -config /etc/ws-tcp-gateway/config.json
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
